# Local development only. Copy to .env. Do not put production secrets here.
APP_ENV=local
DATABASE_URL=postgresql+psycopg://luminova:luminova@127.0.0.1:5433/luminova
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Webhook imzaları bu anahtardan türetilir. Production'da en az 32 karakterlik rastgele bir değer verin.
WEBHOOK_SECRET_KEY=
# E-posta n8n üzerinden gider (docs/n8n.md, bölüm 3). Adres boşsa e-posta kuyruğa alınmaz.
# MAIL_WEBHOOK_SECRET'i rastgele üretin; docker compose bunu n8n'e LUMINOVA_MAIL_SECRET olarak verir.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
# E-postalardaki bağlantıların kökü.
PUBLIC_APP_URL=http://127.0.0.1:5173
